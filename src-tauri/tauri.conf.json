{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShipScheduleHub",
  "version": "1.0.5",
  "identifier": "com.ross.shipschedulehub",
  "build": {
    "beforeDevCommand": "npm install && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm install && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShipScheduleHub — 船期聚合驾驶舱",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 16
        },
        "shadow": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../engine/": "./engine/",
      "../db/": "./db/"
    },
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}